{
  "servers": {
    "rust-analyzer": {
      "capabilities": {
        "flycheck": true,
        "ssr": true,
        "expandMacro": true,
        "runnables": true,
        "relatedTests": true
      },
      "settings": {
        "rust-analyzer": {
          "cargo": {
            "features": "all"
          },
          "check": {
            "command": "clippy"
          }
        }
      }
    }
  }
}
